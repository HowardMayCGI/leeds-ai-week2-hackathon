    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "nx": "24.0.0",
    "oxfmt": "0.74.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.0"
