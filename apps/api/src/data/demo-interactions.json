  "interactions": [
    {
      "id": "levothyroxine--ferrous-sulfate",
      "ingredients": ["levothyroxine", "ferrous-sulfate"],
      "severity": "moderate",
      "mechanism": "pharmacokinetic",
      "effect": "Iron reduces absorption of levothyroxine.",
      "patientGuidance": "Keep these doses at least 4 hours apart. Ask your pharmacist to confirm the timing and any thyroid blood tests needed.",
      "management": {
        "action": "separate_doses",
        "minimumGapMinutes": 240,
        "direction": "either_order",
        "guidance": "Apply the gap to every dose, including across midnight. Spacing may not eliminate the interaction; thyroid monitoring may still be needed."
      },
      "sourceIds": ["levothyroxine-label"]
    },
    {
      "id": "warfarin--naproxen",
      "ingredients": ["warfarin", "naproxen"],
      "severity": "major",
      "mechanism": "pharmacodynamic",
      "effect": "Increased bleeding risk, including gastrointestinal bleeding.",
      "patientGuidance": "Contact your GP or anticoagulation team promptly to check this combination. Taking the medicines at different times does not remove the risk.",
      "management": {
        "action": "prescriber_review",
        "guidance": "Avoid NSAID use where possible; prescriber to assess alternatives and bleeding risk. Do not automatically stop prescribed anticoagulation."
      },
      "sourceIds": ["warfarin-cuh"]
    },
    {
      "id": "warfarin--aspirin",
      "ingredients": ["warfarin", "aspirin"],
      "severity": "major",
      "mechanism": "pharmacodynamic",
      "effect": "Combined anticoagulant and antiplatelet effects increase bleeding risk.",
      "patientGuidance": "Ask your GP or anticoagulation team to confirm that both medicines are intended. Do not stop either prescribed medicine on your own.",
      "management": {
        "action": "prescriber_review",
        "guidance": "May be intentionally prescribed for selected indications; confirm indication and monitoring. Dose separation does not resolve bleeding risk."
      },
      "sourceIds": ["warfarin-cuh"]
    },
    {
      "id": "clopidogrel--naproxen",
      "ingredients": ["clopidogrel", "naproxen"],
      "severity": "major",
      "mechanism": "pharmacodynamic",
      "effect": "Increased risk of gastrointestinal bleeding.",
      "patientGuidance": "Ask your GP or pharmacist to review this combination. Spacing the doses does not remove the bleeding risk.",
      "management": {
        "action": "prescriber_review",
        "guidance": "Assess alternative analgesia, gastrointestinal protection and bleeding risk."
      },
      "sourceIds": ["naproxen-leaflet"]
    },
    {
      "id": "verapamil--atenolol",
      "ingredients": ["verapamil", "atenolol"],
      "severity": "major",
      "mechanism": "pharmacodynamic",
      "effect": "Additive slowing of heart rate and atrioventricular conduction; possible heart block.",
      "patientGuidance": "Ask your GP to review this combination and any monitoring needed. Changing the dose times does not remove the risk.",
      "management": {
        "action": "prescriber_review",
        "guidance": "Assess heart rate, conduction and cardiac function; specialist supervision may be needed."
      },
      "sourceIds": ["verapamil-label"]
    },
    {
      "id": "verapamil--metoprolol",
      "ingredients": ["verapamil", "metoprolol"],
      "severity": "major",
      "mechanism": "pharmacodynamic",
      "effect": "Additive slowing of heart rate and atrioventricular conduction; possible heart block.",
      "patientGuidance": "Ask your GP to review this combination and any monitoring needed. Changing the dose times does not remove the risk.",
      "management": {
        "action": "prescriber_review",
        "guidance": "Assess heart rate, conduction and cardiac function; specialist supervision may be needed."
      },
      "sourceIds": ["verapamil-label"]
    },
    {
      "id": "verapamil--digoxin",
      "ingredients": ["verapamil", "digoxin"],
      "severity": "major",
      "mechanism": "pharmacokinetic",
      "effect": "Verapamil can increase digoxin concentrations and toxicity risk.",
      "patientGuidance": "Ask your prescriber to check the doses and monitoring. Spacing the doses does not prevent raised digoxin levels.",
      "management": {
        "action": "prescriber_review",
        "guidance": "Review digoxin dose, renal function, levels and heart rate."
      },
      "sourceIds": ["verapamil-label"]
    },
    {
      "id": "verapamil--tacrolimus",
      "ingredients": ["verapamil", "tacrolimus"],
      "severity": "major",
      "mechanism": "pharmacokinetic",
      "effect": "Verapamil can increase tacrolimus exposure.",
      "patientGuidance": "Contact your transplant or specialist team to check this combination and any blood tests needed.",
      "management": {
        "action": "prescriber_review",
        "guidance": "Specialist to assess tacrolimus levels and dose. Dose separation is insufficient."
      },
      "sourceIds": ["tacrolimus-ema"]
    },
    {
      "id": "simvastatin--amlodipine",
      "ingredients": ["simvastatin", "amlodipine"],
      "severity": "moderate",
      "mechanism": "pharmacokinetic",
      "effect": "Increased simvastatin exposure and muscle toxicity risk; dose-dependent.",
      "patientGuidance": "Ask your pharmacist or prescriber to confirm your total daily simvastatin dose. This alert does not mean your prescribed dose exceeds the limit.",
      "management": {
        "action": "dose_review",
        "ingredientId": "simvastatin",
        "maximumDailyDose": {
          "value": 20,
          "unit": "mg"
        },
        "guidance": "Confirm total daily simvastatin is no more than 20mg. Product strength alone is not the daily dose; timing changes do not replace dose assessment."
      },
      "sourceIds": ["simvastatin-mhra"]
    },
